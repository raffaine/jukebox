    width: 270px;
    height: 270px;
    z-index: 3;
    border-radius: 6px;
    overflow: hidden;
    box-shadow:
      12px 0 28px rgba(0, 0, 0, 0.75),
      0 8px 24px rgba(0, 0, 0, 0.6);
    cursor: pointer;
    transition: all 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .vinyl-stage.platter-only .lp-sleeve {
    transform: translateX(-220px) scale(0.88);
    opacity: 0.25;
  }

  .sleeve-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .sleeve-side-ribbon {
    position: absolute;
    bottom: 10px;
    left: 10px;
    right: 10px;
    background: rgba(17, 13, 10, 0.86);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(217, 155, 82, 0.4);
    color: var(--accent-warm);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-align: center;
    padding: 0.28rem 0.5rem;
    border-radius: 4px;
    letter-spacing: 0.05em;
  }

  .vinyl-platter-wrap {
    position: absolute;
    right: 16px;
    width: 268px;
    height: 268px;
    z-index: 2;
    transition: all 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .vinyl-stage.platter-only .vinyl-platter-wrap {
    right: 95px;
    transform: scale(1.06);
    z-index: 4;
  }

  .vinyl-disc {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background:
      radial-gradient(circle, #111 0%, #090909 68%, #1a1a1a 69%, #0a0a0a 71%, #141414 100%);
    box-shadow:
      0 10px 30px rgba(0, 0, 0, 0.85),
      inset 0 0 0 2px rgba(255, 255, 255, 0.06);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: spinVinyl 4.5s linear infinite;
    animation-play-state: paused;
  }

  .vinyl-stage[data-playing='true'] .vinyl-disc {
    animation-play-state: running;
  }

  @keyframes spinVinyl {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  .vinyl-grooves {
    position: absolute;
    inset: 10px;
    border-radius: 50%;
    background: repeating-radial-gradient(
      circle,
      rgba(255, 255, 255, 0.035) 0px,
      rgba(255, 255, 255, 0.035) 1px,
      transparent 2px,
      transparent 4px
    );
    pointer-events: none;
  }

  .vinyl-sheen {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: conic-gradient(
      from 35deg,
      transparent 0deg,
      rgba(255, 232, 198, 0.09) 25deg,
      transparent 55deg,
      transparent 180deg,
      rgba(255, 232, 198, 0.09) 205deg,
      transparent 235deg
    );
    pointer-events: none;
  }

  .vinyl-center-label {
    width: 98px;
    height: 98px;
    border-radius: 50%;
    background: radial-gradient(circle, #9e4332 0%, #6d291d 100%);
    border: 2px solid #e3c398;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 6px;
    position: relative;
    z-index: 3;
    transition: background 0.35s ease;
  }

  .vinyl-center-label[data-side='B'] {
    background: radial-gradient(circle, #2e6353 0%, #1c3f35 100%);
  }

  .label-ring {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    border: 1px solid rgba(255, 240, 218, 0.4);
    padding: 4px;
    color: #f9ecda;
  }

  .label-top {
    font-family: var(--font-mono);
    font-size: 0.42rem;
    letter-spacing: 0.06em;
    opacity: 0.85;
  }

  .label-album-title {
    font-family: var(--font-display);
    font-size: 0.46rem;
    margin-top: 2px;
  }

  .label-side-indicator {
    font-family: var(--font-mono);
    font-size: 0.5rem;
    font-weight: 700;
    color: #ffd39b;
    margin-bottom: 14px;
  }

  .label-track-Readout {
    font-family: var(--font-mono);
    font-size: 0.42rem;
    max-width: 78px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .spindle-hole {
    position: absolute;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #120d0a;
    border: 1.5px solid rgba(255, 255, 255, 0.35);
  }

  /* TONEARM */
  .tonearm-assembly {
    position: absolute;
    top: -6px;
    right: -8px;
    width: 60px;
    height: 220px;
    pointer-events: none;
    z-index: 6;
  }

  .tonearm-base {
    position: absolute;
    top: 8px;
    right: 6px;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: radial-gradient(circle, #c89d66 0%, #523d28 80%);
    border: 2px solid rgba(255, 255, 255, 0.2);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.6);
  }

  .tonearm-rod {
    position: absolute;
    top: 25px;
    right: 21px;
    width: 5px;
    height: 168px;
    background: linear-gradient(90deg, #d7b58a, #8a6c49);
    border-radius: 4px;
    transform-origin: top center;
    transform: rotate(0deg);
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    box-shadow: -3px 4px 8px rgba(0, 0, 0, 0.55);
  }

  .tonearm-headshell {
    position: absolute;
    bottom: -8px;
    left: -5px;
    width: 14px;
    height: 22px;
    background: #2c2018;
    border: 1px solid #d7b58a;
    border-radius: 3px;
    transform: rotate(18deg);
  }

  /* SIDE FLIP BANNER */
  .side-flip-banner {
    margin-top: 0.85rem;
    padding: 0.75rem 1rem;
    border-radius: 10px;
    background: rgba(158, 67, 50, 0.32);
    border: 1px solid var(--accent);
    display: flex;
    align-items: center;
    gap: 0.85rem;
    font-size: 0.8rem;
  }

  .flip-spinner {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 2px solid var(--accent-warm);
    border-top-color: transparent;
    animation: spinVinyl 0.9s linear infinite;
    flex-shrink: 0;
  }

  /* SIDE NARRATIVE BOX */
  .side-narrative-box {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 12px;
    padding: 0.85rem 1rem;
  }

  .side-narrative-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.45rem;
  }

  .side-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--accent-warm);
  }

  .side-filter-group {
    display: flex;
    gap: 0.3rem;
  }

  .filter-pill {
    background: transparent;
    border: 1px solid var(--border-subtle);
    color: var(--text-muted);
    font-size: 0.68rem;
    padding: 0.18rem 0.55rem;
    border-radius: 999px;
    cursor: pointer;
  }

  .filter-pill.active {
    background: rgba(217, 155, 82, 0.16);
    color: var(--accent-warm);
    border-color: var(--accent);
  }

  .side-narrative-text {
    font-size: 0.8rem;
    line-height: 1.48;
    color: var(--text-secondary);
  }

  /* TRACKLIST */
  .tracklist-container {
    display: flex;
    flex-direction: column;
    gap: 0.38rem;
  }

  .track-row {
    display: grid;
    grid-template-columns: 34px 1fr auto;
    align-items: center;
    gap: 0.75rem;
    padding: 0.68rem 0.85rem;
    border-radius: 10px;
    background: rgba(28, 21, 15, 0.72);
    border: 1px solid rgba(217, 155, 82, 0.12);
    color: var(--text-main);
    text-align: left;
    cursor: pointer;
    transition: all 0.18s ease;
  }

  .track-row:hover {
    background: rgba(48, 35, 25, 0.82);
    border-color: rgba(217, 155, 82, 0.32);
  }

  .track-row.active {
    background: linear-gradient(90deg, rgba(158, 67, 50, 0.32), rgba(217, 155, 82, 0.14));
    border-color: var(--accent);
  }

  .track-num-col {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .track-eq-bars {
    display: none;
    align-items: flex-end;
    gap: 2px;
    height: 13px;
  }

  .track-eq-bars i {
    width: 3px;
    background: var(--accent-warm);
    display: inline-block;
    animation: eqPulse 0.8s ease-in-out infinite alternate;
  }

  .track-eq-bars i:nth-child(2) {
    animation-delay: 0.2s;
  }
  .track-eq-bars i:nth-child(3) {
    animation-delay: 0.4s;
  }

  @keyframes eqPulse {
    from {
      height: 3px;
    }
    to {
      height: 13px;
    }
  }

  .track-row.active .track-num-text {
    display: none;
  }
  .track-row.active .track-eq-bars {
    display: inline-flex;
  }

  .track-title-line {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  .track-title {
    font-weight: 600;
    font-size: 0.9rem;
  }

  .track-subtitle {
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .track-turn-badge {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    background: rgba(158, 67, 50, 0.35);
    border: 1px solid rgba(217, 155, 82, 0.35);
    color: var(--accent-warm);
    padding: 0.08rem 0.42rem;
    border-radius: 4px;
  }

  .track-sub-line {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.73rem;
    color: var(--text-muted);
    margin-top: 0.18rem;
  }

  .track-bpm {
    font-family: var(--font-mono);
    color: var(--text-secondary);
  }

  .track-dur-col {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-secondary);
  }

  /* RIGHT COLUMN: LYRICS & BOOKLET */
  .lyrics-column {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-height: 760px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.45);
  }

  .booklet-tabs-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1.25rem;
    background: rgba(20, 15, 11, 0.75);
    border-bottom: 1px solid var(--border-subtle);
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .booklet-tabs {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .booklet-tab {
    padding: 0.45rem 0.9rem;
    border-radius: 8px;
    background: transparent;
    border: 1px solid transparent;
    color: var(--text-muted);
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .booklet-tab:hover {
    color: var(--text-main);
  }

  .booklet-tab.active {
    background: rgba(217, 155, 82, 0.16);
    border-color: var(--border-strong);
    color: var(--accent-warm);
  }

  .lyrics-controls {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .tool-mini-btn {
    background: rgba(38, 28, 20, 0.8);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 0.28rem 0.55rem;
    border-radius: 6px;
    cursor: pointer;
  }

  .tool-mini-btn.active {
    border-color: var(--accent);
    color: var(--accent-warm);
    background: rgba(217, 155, 82, 0.16);
  }

  /* TRACK HERO HEADER */
  .track-hero-header {
    padding: 1.35rem 1.75rem 1.1rem;
    border-bottom: 1px solid var(--border-subtle);
    background: linear-gradient(180deg, rgba(45, 31, 21, 0.55) 0%, rgba(25, 18, 13, 0.2) 100%);
  }

  .track-hero-badges {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.55rem;
  }

  .hero-side-badge {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.18rem 0.55rem;
    border-radius: 4px;
    background: #8c3b2b;
    color: #fff2e2;
  }

  .hero-side-badge[data-side='B'] {
    background: #2d5a4c;
  }

  .hero-meta-badge {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 0.18rem 0.55rem;
    border-radius: 4px;
    background: rgba(217, 155, 82, 0.12);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
  }

  .track-hero-title {
    font-family: var(--font-display);
    font-size: 1.9rem;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 0.75rem;
    line-height: 1.18;
  }

  .track-liner-note {
    background: rgba(243, 234, 216, 0.06);
    border-left: 3px solid var(--accent);
    padding: 0.65rem 1rem;
    border-radius: 0 8px 8px 0;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.95rem;
    color: var(--accent-warm);
    line-height: 1.5;
  }

  .quote-mark {
    color: var(--accent);
    font-weight: 700;
  }

  /* LYRICS VIEWPORT */
  .lyrics-scroll-viewport {
    padding: 1.5rem 1.75rem;
    max-height: 540px;
    overflow-y: auto;
  }

  .lyrics-stanzas-list {
    --lyric-scale: 1;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  :global(.lyric-stanza) {
    position: relative;
    padding: 0.95rem 1.2rem;
    border-radius: 12px;
    background: rgba(22, 16, 12, 0.45);
    border: 1px solid transparent;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  :global(.lyric-stanza:hover) {
    background: rgba(45, 33, 24, 0.55);
    border-color: rgba(217, 155, 82, 0.25);
  }

  :global(.lyric-stanza.active) {
    background: linear-gradient(135deg, rgba(158, 67, 50, 0.24), rgba(217, 155, 82, 0.12));
    border-color: var(--accent);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
  }

  :global(.stanza-time-tag) {
    position: absolute;
    top: 0.65rem;
    right: 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-muted);
    opacity: 0.65;
  }

  :global(.lyric-stanza.active .stanza-time-tag) {
    color: var(--accent-warm);
    opacity: 1;
  }

  :global(.lyric-line) {
    font-family: var(--font-display);
    font-size: calc(1.12rem * var(--lyric-scale, 1));
    line-height: 1.68;
    color: var(--text-secondary);
    transition: color 0.2s ease;
  }

  :global(.lyric-stanza.active .lyric-line) {
    color: #fff6ea;
    font-weight: 500;
  }

  .lyrics-footer-nav {
    margin-top: 1.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn-lyric-step {
    background: rgba(42, 31, 22, 0.85);
    border: 1px solid var(--border-subtle);
    color: var(--text-main);
    padding: 0.45rem 0.9rem;
    border-radius: 8px;
    font-size: 0.8rem;
    cursor: pointer;
  }

  .btn-lyric-step:hover {
    border-color: var(--accent);
  }

  .lyric-hint {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  /* GATEFOLD, SONGBOOK & STUDIO PANELS */
  .gatefold-scroll,
  .studio-scroll,
  .songbook-scroll {
    padding: 1.5rem 1.75rem;
    max-height: 700px;
    overflow-y: auto;
  }

  .sb-header-card {
    background: rgba(20, 15, 11, 0.65);
    border: 1px solid var(--border-subtle);
    border-radius: 12px;
    padding: 1.25rem;
    margin-bottom: 1.15rem;
  }

  .sb-title-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 0.9rem;
  }

  .sb-track-title {
    font-family: var(--font-display);
    font-size: 1.65rem;
    color: var(--text-main);
  }

  .sb-transposer-box {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.3rem;
  }

  .sb-trans-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-muted);
  }

  .sb-trans-buttons {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .sb-trans-btn {
    background: rgba(45, 33, 24, 0.85);
    border: 1px solid var(--border-subtle);
    color: var(--text-main);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding: 0.3rem 0.6rem;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .sb-trans-btn:hover {
    border-color: var(--accent);
    color: var(--accent-warm);
  }

  .sb-trans-easy {
    background: rgba(45, 90, 76, 0.45);
    border-color: rgba(93, 179, 152, 0.45);
    color: #c9f2e4;
  }

  .sb-trans-readout {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--accent-warm);
    padding: 0 0.35rem;
    min-width: 96px;
    text-align: center;
  }

  .sb-meta-pills {
    display: flex;
    gap: 0.65rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .sb-pill {
    background: rgba(38, 28, 20, 0.75);
    border: 1px solid var(--border-subtle);
    padding: 0.42rem 0.75rem;
    border-radius: 8px;
    font-size: 0.78rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .sb-pill-k {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--text-muted);
  }

  .sb-pill strong {
    color: var(--accent-warm);
    font-family: var(--font-mono);
  }

  .sb-curtain-box {
    background: rgba(243, 234, 216, 0.05);
    border-left: 3px solid var(--accent);
    padding: 0.85rem 1.1rem;
    border-radius: 0 10px 10px 0;
  }

  .sb-curtain-title {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--accent);
    text-transform: uppercase;
    margin-bottom: 0.45rem;
  }

  .sb-pdf-mini-link {
    color: var(--accent-warm);
    text-decoration: none;
    background: rgba(217, 155, 82, 0.15);
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    border: 1px solid var(--border-subtle);
  }

  .sb-curtain-box p {
    font-size: 0.88rem;
    line-height: 1.58;
    color: var(--text-secondary);
  }

  .sb-feel-line {
    margin-top: 0.5rem;
    font-size: 0.82rem !important;
    color: var(--text-muted) !important;
  }

  .sb-feel-line strong {
    color: var(--accent-warm);
  }

  .sb-mid-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 1rem;
    margin-bottom: 1.15rem;
  }

  @media (max-width: 920px) {
    .sb-mid-grid {
      grid-template-columns: 1fr;
    }
  }

  .sb-groove-card,
  .sb-chords-card,
  .sb-sheet-card {
    background: rgba(20, 15, 11, 0.62);
    border: 1px solid var(--border-subtle);
    border-radius: 12px;
    padding: 1.1rem;
  }

  :global(.groove-matrix) {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-top: 0.45rem;
  }

  :global(.groove-row) {
    display: grid;
    grid-template-columns: 120px repeat(8, 1fr);
    align-items: center;
    gap: 0.28rem;
  }

  :global(.groove-voice-name) {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.groove-cell) {
    height: 26px;
    border-radius: 5px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(217, 155, 82, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-muted);
  }

  :global(.groove-cell.groove-sub) {
    background: transparent;
