---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Jukebox — Sala de Audição de LPs e Encartes Interativos' } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..800;1,9..144,400..600&family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="grain-overlay" aria-hidden="true"></div>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --bg-primary: #110d0a;
    --bg-secondary: #1b140f;
    --bg-card: rgba(31, 23, 17, 0.82);
    --bg-elevated: rgba(45, 33, 24, 0.85);
    --border-subtle: rgba(217, 155, 82, 0.18);
    --border-strong: rgba(217, 155, 82, 0.42);
    --accent: #d99b52;
    --accent-warm: #e6b87d;
    --accent-rust: #9e4332;
    --accent-teal: #356959;
    --text-main: #f3e7d6;
    --text-secondary: #cbb9a3;
    --text-muted: #937f69;
    --font-display: 'Fraunces', 'Baskerville', 'Georgia', serif;
    --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    --font-mono: 'IBM Plex Mono', 'American Typewriter', 'Courier New', monospace;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html,
  body {
    background-color: var(--bg-primary);
    color: var(--text-main);
    font-family: var(--font-sans);
    min-height: 100vh;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
  }

  body {
    background-image:
      radial-gradient(circle at 18% 15%, rgba(158, 67, 50, 0.16) 0%, transparent 45%),
      radial-gradient(circle at 82% 25%, rgba(217, 155, 82, 0.12) 0%, transparent 50%),
      radial-gradient(circle at 50% 90%, rgba(45, 30, 18, 0.5) 0%, var(--bg-primary) 75%);
  }

  .grain-overlay {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 999;
    opacity: 0.045;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
  }

  ::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }
  ::-webkit-scrollbar-track {
    background: rgba(17, 13, 10, 0.6);
  }
  ::-webkit-scrollbar-thumb {
    background: rgba(217, 155, 82, 0.28);
    border-radius: 4px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: rgba(217, 155, 82, 0.5);
  }
</style>
