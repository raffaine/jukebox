---
import type { Album } from '../lib/catalog';

interface Props {
  album: Album;
  allAlbums: Album[];
}

const { album, allAlbums } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (p: string) => (p.startsWith('http') ? p : `${baseUrl}${p.startsWith('/') ? p : `/${p}`}`);

const normalizedAlbum = {
  ...album,
  coverUrl: withBase(album.coverUrl),
  bookletPdfUrl: withBase(album.bookletPdfUrl),
  songbookPdfUrl: album.songbookPdfUrl ? withBase(album.songbookPdfUrl) : withBase('/lps/gravetos-no-escuro/songbook-gravetos-no-escuro.pdf'),
  tracks: album.tracks.map((t) => ({
    ...t,
    audioUrl: withBase(t.audioUrl),
  })),
};
const initialTrack = normalizedAlbum.tracks[0];
const initialSongbook = initialTrack.songbook;
---

<div class="jukebox-shell" data-album-id={album.id}>
  <!-- Top Bar / Navigation -->
  <header class="topbar">
    <div class="brand-group">
      <a href={withBase('/')} class="brand-logo" title="Jukebox — Sala de Audição">
        <span class="vinyl-icon" aria-hidden="true">
          <span class="vinyl-dot"></span>
        </span>
        <div>
          <span class="brand-title">JUKEBOX</span>
          <span class="brand-sub">SALA DE AUDIÇÃO · 33 ⅓ RPM</span>
        </div>
      </a>

      <div class="divider-v"></div>

      <button type="button" class="crate-trigger" id="btn-open-crate" aria-expanded="false">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 6h16M4 12h16M4 18h10" />
        </svg>
        <span>Estante de LPs ({allAlbums.length})</span>
        <span class="current-lp-pill">{album.title}</span>
      </button>
    </div>

    <div class="topbar-actions">
      <button type="button" class="action-chip" id="btn-crackle-toggle" title="Ativar/Desativar chiado analógico de agulha no vinil">
        <span class="led-indicator" id="crackle-led"></span>
        <span>Agulha no Sulco</span>
      </button>

      <a
        href={normalizedAlbum.bookletPdfUrl}
        target="_blank"
        rel="noopener"
        class="action-chip action-chip-gold"
        title="Abrir encarte diagramado em PDF (Estética Vinil Anos 70)"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <line x1="12" y1="18" x2="12" y2="12"></line>
          <polyline points="9 15 12 18 15 15"></polyline>
        </svg>
        <span>Encarte PDF</span>
      </a>

      <a
        href={normalizedAlbum.songbookPdfUrl}
        target="_blank"
        rel="noopener"
        class="action-chip action-chip-songbook"
        title="Abrir Songbook Oficial em PDF (Cifras, Harmonia e Bastidores)"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 18V5l12-2v13"></path>
          <circle cx="6" cy="18" r="3"></circle>
          <circle cx="18" cy="16" r="3"></circle>
        </svg>
        <span>Songbook PDF</span>
      </a>
    </div>
  </header>

  <!-- Multi-LP Crate Drawer (Estante de Discos) -->
  <section class="crate-drawer" id="crate-drawer" hidden>
    <div class="crate-inner">
      <div class="crate-header">
        <div>
          <h2>Estante de Vinis — Acervo Jukebox</h2>
          <p>Selecione um LP para colocar no prato ou adicione novas obras na pasta <code>lps/</code>.</p>
        </div>
        <button type="button" class="btn-close-crate" id="btn-close-crate" aria-label="Fechar estante">✕</button>
      </div>
      <div class="crate-grid">
        {
          allAlbums.map((item) => (
            <a
              href={withBase(`/lp/${item.slug}`)}
              class:list={['crate-card', { active: item.slug === album.slug }]}
            >
              <div class="crate-card-cover">
                <img src={withBase(item.coverUrl)} alt={`Capa de ${item.title}`} loading="lazy" />
                <span class="crate-card-vinyl"></span>
              </div>
              <div class="crate-card-meta">
                <span class="crate-card-genre">{item.genre}</span>
                <h3>{item.title}</h3>
                <p>{item.subtitle} · {item.totalDurationFormatted}</p>
              </div>
            </a>
          ))
        }

        <div class="crate-card crate-card-new">
          <div class="crate-new-icon">+</div>
          <div class="crate-card-meta">
            <span class="crate-card-genre">PRÓXIMA OBRA</span>
            <h3>Adicionar Novo LP</h3>
            <p>
              Crie uma pasta em <code>lps/nome_do_disco/</code> com <code>album.json</code>, áudios e capa para aparecer automaticamente aqui.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Listening Room Grid -->
  <main class="listening-room">
    <!-- COLUNA ESQUERDA: VITROLA, CAPA, VIRAR DISCO E FAIXAS -->
    <section class="turntable-column">
      <!-- Side Switcher ("Chave Virar Disco") -->
      <div class="side-switcher-bar">
        <div class="side-tabs" role="tablist" aria-label="Lado do Disco">
          <button
            type="button"
            class="side-tab active"
            data-side-btn="A"
            id="btn-side-a"
          >
            <span class="side-badge side-a-dot">LADO A</span>
            <span class="side-name">{album.sides.A.title}</span>
            <span class="side-time">{album.sides.A.durationFormatted}</span>
          </button>
          <button
            type="button"
            class="side-tab"
            data-side-btn="B"
            id="btn-side-b"
          >
            <span class="side-badge side-b-dot">LADO B</span>
            <span class="side-name">{album.sides.B.title}</span>
            <span class="side-time">{album.sides.B.durationFormatted}</span>
          </button>
        </div>

        <button
          type="button"
          class="btn-flip-disc"
          id="btn-flip-disc"
          title="Virar o disco (Atalho: tecla F)"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="17 1 21 5 17 9"></polyline>
            <path d="M3 11V9a4 4 0 0 1 4-4h14"></path>
            <polyline points="7 23 3 19 7 15"></polyline>
            <path d="M21 13v2a4 4 0 0 1-4 4H3"></path>
          </svg>
          <span>Virar Disco</span>
        </button>
      </div>

      <!-- Turntable & Sleeve Stage -->
      <div class="vinyl-stage" id="vinyl-stage" data-active-side="A" data-playing="false">
        <div class="stage-view-toggle">
          <button type="button" class="stage-mode-btn active" data-stage-mode="sleeve" id="mode-sleeve-btn">
            Capa + Vinil
          </button>
          <button type="button" class="stage-mode-btn" data-stage-mode="platter" id="mode-platter-btn">
            Vitrola Aberta
          </button>
        </div>

        <div class="sleeve-and-record" id="sleeve-and-record">
          <!-- Capa do LP -->
          <div class="lp-sleeve" id="lp-sleeve" title="Clique para alternar foco entre Capa e Vitrola">
            <img src={normalizedAlbum.coverUrl} alt={`Capa do LP ${album.title}`} class="sleeve-img" />
            <div class="sleeve-ringwear"></div>
            <div class="sleeve-side-ribbon" id="sleeve-side-ribbon">
              LADO A · O PESO E A MÁSCARA
            </div>
          </div>

          <!-- Prato e Disco de Vinil 12" -->
          <div class="vinyl-platter-wrap">
            <div class="vinyl-disc" id="vinyl-disc">
              <div class="vinyl-grooves"></div>
              <div class="vinyl-sheen"></div>
              <div class="vinyl-center-label" id="vinyl-center-label">
                <div class="label-ring">
                  <span class="label-top">SINTROPIA · 33 ⅓ RPM</span>
                  <strong class="label-album-title">{album.title.toUpperCase()}</strong>
                  <span class="label-side-indicator" id="label-side-indicator">LADO A</span>
                  <span class="label-track-Readout" id="label-track-readout">01. Herança de Sal</span>
                  <div class="spindle-hole"></div>
                </div>
              </div>
            </div>

            <!-- Braço da Vitrola (Tonearm) -->
            <div class="tonearm-assembly" id="tonearm-assembly">
              <div class="tonearm-base"></div>
              <div class="tonearm-rod" id="tonearm-rod">
                <div class="tonearm-headshell"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- Aviso de Virada Dramática do Lado A -> Lado B (3.5s) -->
        <div class="side-flip-banner" id="side-flip-banner" hidden>
          <div class="flip-spinner"></div>
          <div>
            <strong>Fim do Lado A — Silêncio Dramático (3.5s)</strong>
            <p>Levantando a agulha e virando o vinil para o Lado B: <em>A Fagulha e a Travessia</em>...</p>
          </div>
        </div>
      </div>

      <!-- Descrição Dramática do Lado Ativo -->
      <div class="side-narrative-box" id="side-narrative-box">
        <div class="side-narrative-header">
          <span class="side-tag" id="narrative-side-tag">LADO A — O PESO E A MÁSCARA</span>
          <span class="side-filter-group">
            <button type="button" class="filter-pill active" data-filter="side" id="filter-side-btn">
              Ver Lado Ativo
            </button>
            <button type="button" class="filter-pill" data-filter="all" id="filter-all-btn">
              Todas as 9 Faixas
            </button>
          </span>
        </div>
        <p class="side-narrative-text" id="narrative-side-desc">
          {album.sides.A.description}
        </p>
      </div>

      <!-- Lista de Faixas (Tracklist) -->
      <div class="tracklist-container" role="list" id="tracklist-container">
        {
          album.tracks.map((track, idx) => (
            <button
              type="button"
              class:list={['track-row', { active: idx === 0 }]}
              data-track-index={idx}
              data-track-side={track.side}
            >
              <div class="track-num-col">
                <span class="track-num-text">{track.numberStr}</span>
                <span class="track-eq-bars" aria-hidden="true">
                  <i></i><i></i><i></i>
                </span>
              </div>

              <div class="track-info-col">
                <div class="track-title-line">
                  <span class="track-title">{track.title}</span>
                  {track.subtitle && <span class="track-subtitle">({track.subtitle})</span>}
                  {track.pauseAfterSeconds > 0 && (
                    <span class="track-turn-badge" title="3.5 segundos de silêncio dramático no fim do Lado A">
                      Virada Lado A (+{track.pauseAfterSeconds}s)
                    </span>
                  )}
                </div>
                <div class="track-sub-line">
                  <span class="track-side-mini">Lado {track.side}</span>
                  <span>·</span>
                  <span>{track.style}</span>
                  <span>·</span>
                  <span class="track-bpm">{track.bpm} BPM</span>
                </div>
              </div>

              <div class="track-dur-col">
                <span>{track.durationFormatted}</span>
              </div>
            </button>
          ))
        }
      </div>
    </section>

    <!-- COLUNA DIREITA: LETRAS SINCRONIZADAS, ENCARTE E FICHA TÉCNICA -->
    <section class="lyrics-column">
      <!-- Abas de Conteúdo do Encarte -->
      <div class="booklet-tabs-bar">
        <div class="booklet-tabs" role="tablist">
          <button type="button" class="booklet-tab active" data-tab-target="lyrics" id="tab-btn-lyrics">
            Letra & Crônica
          </button>
          <button type="button" class="booklet-tab" data-tab-target="songbook" id="tab-btn-songbook">
            Songbook & Cifras
          </button>
          <button type="button" class="booklet-tab" data-tab-target="gatefold" id="tab-btn-gatefold">
            Capa Interna & Contracapa
          </button>
          <button type="button" class="booklet-tab" data-tab-target="studio" id="tab-btn-studio">
            Master, Vídeo & Capítulos
          </button>
        </div>

        <div class="lyrics-controls" id="lyrics-toolbar">
          <button
            type="button"
            class="tool-mini-btn active"
            id="btn-autoscroll"
            title="Rolar a letra automaticamente conforme a música avança"
          >
            Auto-Scroll
          </button>
          <button type="button" class="tool-mini-btn" id="btn-font-dec" title="Diminuir fonte da letra">A-</button>
          <button type="button" class="tool-mini-btn" id="btn-font-inc" title="Aumentar fonte da letra">A+</button>
        </div>
      </div>

      <!-- PAINEL 1: LETRA SINCRONIZADA E NOTA DE ENCARTE -->
      <div class="tab-panel active" id="panel-lyrics">
        <div class="track-hero-header">
          <div class="track-hero-badges">
            <span class="hero-side-badge" id="hero-side-badge">LADO A · FAIXA {initialTrack.numberStr}</span>
            <span class="hero-meta-badge" id="hero-style-badge">{initialTrack.style}</span>
            <span class="hero-meta-badge" id="hero-bpm-badge">{initialTrack.bpm} BPM</span>
            <span class="hero-meta-badge" id="hero-dur-badge">{initialTrack.durationFormatted}</span>
          </div>

          <h1 class="track-hero-title" id="hero-track-title">{initialTrack.fullTitle}</h1>

          <blockquote class="track-liner-note" id="hero-liner-note">
            <span class="quote-mark">“</span>
            <span id="hero-liner-text">{initialTrack.linerNote}</span>
            <span class="quote-mark">”</span>
          </blockquote>
        </div>

        <div class="lyrics-scroll-viewport" id="lyrics-viewport">
          <div class="lyrics-stanzas-list" id="lyrics-stanzas-list">
            {
              initialTrack.stanzas.map((stanza, sIdx) => (
                <div
                  class:list={['lyric-stanza', { active: sIdx === 0 }]}
                  data-stanza-index={sIdx}
                  data-start={stanza.startTime}
                  data-end={stanza.endTime}
                  title="Clique para pular para este trecho da faixa"
                >
                  <span class="stanza-time-tag">
                    {String(Math.floor(stanza.startTime / 60)).padStart(2, '0')}:
                    {String(Math.floor(stanza.startTime % 60)).padStart(2, '0')}
                  </span>
                  {stanza.lines.map((line) => (
                    <p class="lyric-line">{line}</p>
                  ))}
                </div>
              ))
            }
          </div>

          <div class="lyrics-footer-nav">
            <button type="button" class="btn-lyric-step" id="btn-lyric-prev">← Faixa Anterior</button>
            <span class="lyric-hint">Dica: Clique em qualquer estrofe para avançar o áudio para aquele trecho</span>
            <button type="button" class="btn-lyric-step" id="btn-lyric-next">Próxima Faixa →</button>
          </div>
        </div>
      </div>

      <!-- PAINEL NOVO: SONGBOOK, CIFRAS, ACORDES & BASTIDORES -->
      <div class="tab-panel" id="panel-songbook" hidden>
        <div class="songbook-scroll">
          <!-- Cabeçalho do Songbook da Faixa -->
          <div class="sb-header-card">
            <div class="sb-title-row">
              <div>
                <span class="section-eyebrow" id="sb-eyebrow">
                  POR TRÁS DA CORTINA · FAIXA {initialTrack.numberStr} (LADO {initialTrack.side})
                </span>
                <h2 class="sb-track-title" id="sb-track-title">{initialTrack.fullTitle}</h2>
              </div>

              <!-- Transpositor Interativo de Tom -->
              <div class="sb-transposer-box">
                <span class="sb-trans-label">Transpor Cifra:</span>
                <div class="sb-trans-buttons">
                  <button type="button" class="sb-trans-btn" id="btn-trans-down" title="Descer 1 semitom (-1)">-1</button>
                  <span class="sb-trans-readout" id="sb-trans-readout">0 st (Original)</span>
                  <button type="button" class="sb-trans-btn" id="btn-trans-up" title="Subir 1 semitom (+1)">+1</button>
                  <button type="button" class="sb-trans-btn sb-trans-easy" id="btn-trans-easy" title="Aplicar sugestão de Violão Fácil / Capotraste">
                    Violão Fácil
                  </button>
                  <button type="button" class="sb-trans-btn" id="btn-trans-reset" title="Voltar ao tom original da gravação">
                    Original
                  </button>
                </div>
              </div>
            </div>

            <div class="sb-meta-pills">
              <div class="sb-pill">
                <span class="sb-pill-k">TOM DA GRAVAÇÃO:</span>
                <strong id="sb-key-badge">{initialSongbook?.key}</strong>
              </div>
              <div class="sb-pill">
                <span class="sb-pill-k">COMPASSO / PULSO:</span>
                <strong id="sb-time-badge">{initialSongbook?.timeSignature} · {initialTrack.bpm} BPM</strong>
              </div>
              <div class="sb-pill sb-pill-capo">
                <span class="sb-pill-k">DICA DE VIOLÃO:</span>
                <strong id="sb-capo-badge">{initialSongbook?.capoHint}</strong>
              </div>
            </div>

            <!-- Análise Harmônica ("Por Trás da Cortina") -->
            <div class="sb-curtain-box">
              <div class="sb-curtain-title">
                <span>Bastidores da Harmonia & Arranjo</span>
                <a href={normalizedAlbum.songbookPdfUrl} target="_blank" rel="noopener" class="sb-pdf-mini-link">
                  ↓ Baixar Songbook Completo (PDF)
                </a>
              </div>
              <p id="sb-curtain-text">{initialSongbook?.behindTheCurtain}</p>
              <p class="sb-feel-line">
                <strong>Levada & Instrumentação:</strong> <span id="sb-feel-text">{initialSongbook?.feel}</span>
              </p>
            </div>
          </div>

          <!-- Grid Rítmico (Groove / Levada) + Dicionário Visual de Acordes (SVG) -->
          <div class="sb-mid-grid">
            <div class="sb-groove-card">
              <span class="section-eyebrow" id="sb-groove-label">{initialSongbook?.groovePattern.label}</span>
              <div class="groove-matrix" id="sb-groove-matrix"></div>
            </div>

            <div class="sb-chords-card">
              <div class="sb-chords-head">
                <span class="section-eyebrow">DICIONÁRIO DE VOICINGS (CLIQUE PARA OUVIR O ACORDE)</span>
              </div>
              <div class="chord-diagrams-grid" id="sb-chord-diagrams"></div>
            </div>
          </div>

          <!-- Folha de Cifra Completa sobre a Letra -->
          <div class="sb-sheet-card">
            <div class="sb-sheet-header">
              <span class="section-eyebrow">CIFRA COMPLETA & ESTRUTURA DA FAIXA</span>
              <span class="sb-sheet-hint">Os acordes em destaque acompanham a transposição selecionada acima</span>
            </div>
            <div class="sb-chord-sheet" id="sb-chord-sheet"></div>
          </div>
        </div>
      </div>

      <!-- PAINEL 2: CAPA INTERNA (EPÍGRAFE), CONTRACAPA E CRÉDITOS -->
      <div class="tab-panel" id="panel-gatefold" hidden>
        <div class="gatefold-scroll">
          <div class="epigraph-card">
            <span class="section-eyebrow">EPÍGRAFE · CAPA INTERNA</span>
            <p class="epigraph-quote">{album.epigraph}</p>
          </div>

          <div class="gatefold-two-col">
            <div class="backcover-essay">
              <span class="section-eyebrow">TEXTO DE CONTRACAPA</span>
              <h3>A Travessia do Quarto Escuro à Cozinha</h3>
              {album.backCoverText.map((para) => <p>{para}</p>)}
            </div>

            <div class="gatefold-specs">
              <span class="section-eyebrow">FICHA TÉCNICA GERAL</span>
              <dl class="specs-list">
                <div>
                  <dt>Título</dt>
                  <dd>{album.title}</dd>
                </div>
                <div>
                  <dt>Formato</dt>
                  <dd>{album.format}</dd>
                </div>
                <div>
                  <dt>Gênero</dt>
                  <dd>{album.genre}</dd>
                </div>
                <div>
                  <dt>Lado A</dt>
                  <dd>{album.sides.A.title} (Faixas 01–05 · {album.sides.A.durationFormatted})</dd>
                </div>
                <div>
                  <dt>Lado B</dt>
                  <dd>{album.sides.B.title} (Faixas 06–09 · {album.sides.B.durationFormatted})</dd>
                </div>
                <div>
                  <dt>Licença</dt>
                  <dd>{album.license}</dd>
                </div>
              </dl>

              <div class="dedication-box">
                <p class="prod-line">{album.credits.production}</p>
                <p class="ded-line">{album.credits.dedication}</p>
              </div>

              <a href={normalizedAlbum.bookletPdfUrl} target="_blank" rel="noopener" class="btn-download-booklet-full">
                <span>Baixar Encarte Completo em PDF (Estética Vinil Anos 70)</span>
                <span>↓ PDF</span>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- PAINEL 3: ESTÚDIO, CAPÍTULOS DO YOUTUBE & PIPELINE (FASES 1 A 5) -->
      <div class="tab-panel" id="panel-studio" hidden>
        <div class="studio-scroll">
          <div class="studio-grid">
            <div class="studio-card">
              <div class="studio-card-head">
                <span class="section-eyebrow">FASE 5 · DISTRIBUIÇÃO YOUTUBE 4K</span>
                <button type="button" class="btn-copy-chapters" id="btn-copy-chapters">
                  Copiar Timestamps
                </button>
              </div>
              <h3>Capítulos Exatos do YouTube (Full Album)</h3>
              <p class="studio-desc">
                Calculados via inspeção exata de duração dos áudios incluindo os 3.5s de pausa dramática na virada do Lado A para o Lado B:
              </p>
              <pre class="chapters-pre" id="chapters-pre">{album.youtubeChapters.map((c) => c.line).join('\n')}</pre>
            </div>

            <div class="studio-card">
              <span class="section-eyebrow">PIPELINE DE PRODUÇÃO LOCAL</span>
              <h3>Assets & Scripts Automatizados</h3>
              <ul class="pipeline-list">
                <li>
                  <strong>Fase 1 (Estrutura & Raw):</strong>
                  <span>9 faixas organizadas em <code>lps/gravetos_escuro/raw/</code> e servidas na Jukebox.</span>
                </li>
                <li>
                  <strong>Fase 2 (Masterização -14 LUFS):</strong>
                  <span>Script <code>npm run album:master</code> (loudnorm I=-14:TP=-1.5:LRA=11 + WAV 24-bit/44.1kHz + FLAC + MP3 320k).</span>
                </li>
                <li>
                  <strong>Fase 3 (Encarte PDF & Capa 3000px):</strong>
                  <span>
                    Template XeLaTeX compilado em <a href={normalizedAlbum.bookletPdfUrl} target="_blank">encarte-gravetos-no-escuro.pdf</a> e capa fechada em <code>3000x3000px</code>.
                  </span>
                </li>
                <li>
                  <strong>Fase 4 (Listening Room Astro):</strong>
                  <span>Alimentada dinamicamente por <code>album.json</code> com suporte multi-LP.</span>
                </li>
                <li>
                  <strong>Fase 5 (Render Vídeo 4K):</strong>
                  <span>Script <code>npm run album:video</code> concatena as 9 faixas sobre a capa em 4K.</span>
                </li>
              </ul>

              <div class="studio-links-row">
                <a href={withBase('/lps/gravetos-no-escuro/album.json')} target="_blank" class="studio-pill-link">
                  Ver album.json
                </a>
                <a href={normalizedAlbum.bookletPdfUrl} target="_blank" class="studio-pill-link">
                  Abrir Encarte PDF
                </a>
                <a href={normalizedAlbum.coverUrl} target="_blank" class="studio-pill-link">
                  Abrir Arte da Capa
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- Barra Inferior Fixa: Deck Hi-Fi Contínuo -->
  <footer class="hifi-deck">
    <audio id="jukebox-audio" preload="metadata" src={initialTrack.audioUrl}></audio>

    <div class="deck-now-playing">
      <img src={normalizedAlbum.coverUrl} alt={album.title} class="deck-thumb" id="deck-thumb" />
      <div class="deck-track-meta">
        <div class="deck-side-line">
          <span class="deck-side-pill" id="deck-side-pill">LADO A</span>
          <span class="deck-bpm-pill" id="deck-bpm-pill">{initialTrack.bpm} BPM</span>
        </div>
        <strong class="deck-track-title" id="deck-track-title">
          {initialTrack.numberStr}. {initialTrack.title}
        </strong>
        <span class="deck-track-style" id="deck-track-style">{initialTrack.style}</span>
      </div>
    </div>

    <div class="deck-transport-center">
      <div class="transport-buttons">
        <button type="button" class="deck-btn" id="btn-prev" title="Faixa anterior (Tecla P)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M6 6h2v12H6zm3.5 6l8.5 6V6z" />
          </svg>
        </button>

        <button type="button" class="deck-btn-play" id="btn-play" title="Tocar / Pausar (Espaço)">
          <svg class="icon-play" id="icon-play" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
            <path d="M8 5v14l11-7z" />
          </svg>
          <svg class="icon-pause" id="icon-pause" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" hidden>
            <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z" />
          </svg>
        </button>

        <button type="button" class="deck-btn" id="btn-next" title="Próxima faixa (Tecla N)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z" />
          </svg>
        </button>

        <button
          type="button"
          class="deck-btn deck-btn-side"
          id="btn-deck-flip"
          title="Virar para o outro lado do disco (Tecla F)"
        >
          <span>⇄ Lado A/B</span>
        </button>
      </div>

      <div class="deck-scrubber-row">
        <span class="time-readout" id="time-current">00:00</span>
        <div class="scrubber-wrap">
          <input
            type="range"
            id="seek-slider"
            class="seek-slider"
            min="0"
            max={initialTrack.durationSeconds}
            step="0.1"
            value="0"
            aria-label="Progresso da faixa"
          />
        </div>
        <span class="time-readout" id="time-total">{initialTrack.durationFormatted}</span>
      </div>
    </div>

    <div class="deck-right-controls">
      <label class="auto-flip-toggle" title="Virar automaticamente do Lado A para o Lado B após os 3.5s de silêncio da faixa 05">
        <input type="checkbox" id="chk-auto-flip" checked />
        <span>Virada Automática A→B</span>
      </label>

      <div class="volume-group">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
          <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
        </svg>
        <input
          type="range"
          id="volume-slider"
          class="volume-slider"
          min="0"
          max="1"
          step="0.02"
          value="0.9"
          aria-label="Volume"
        />
      </div>
    </div>
  </footer>
</div>

<!-- Serialized Album Data for Client-Side Interactivity -->
<script is:inline define:vars={{ albumData: normalizedAlbum }}>
  window.__JUKEBOX_ALBUM__ = albumData;
</script>

<script>
  const album = (window as any).__JUKEBOX_ALBUM__;
  if (album) {
    let currentTrackIdx = 0;
    let activeSide: 'A' | 'B' = 'A';
    let isPlaying = false;
    let autoScrollLyrics = true;
    let trackFilter: 'side' | 'all' = 'side';
    let lyricFontScale = 1;
    let flipTimeoutId: number | null = null;
    let currentTranspose = 0;

    // Songbook DOM Elements
    const sbEyebrow = document.getElementById('sb-eyebrow') as HTMLElement;
    const sbTrackTitle = document.getElementById('sb-track-title') as HTMLElement;
    const sbKeyBadge = document.getElementById('sb-key-badge') as HTMLElement;
    const sbTimeBadge = document.getElementById('sb-time-badge') as HTMLElement;
    const sbCapoBadge = document.getElementById('sb-capo-badge') as HTMLElement;
    const sbCurtainText = document.getElementById('sb-curtain-text') as HTMLElement;
    const sbFeelText = document.getElementById('sb-feel-text') as HTMLElement;
    const sbGrooveLabel = document.getElementById('sb-groove-label') as HTMLElement;
    const sbGrooveMatrix = document.getElementById('sb-groove-matrix') as HTMLElement;
    const sbChordDiagrams = document.getElementById('sb-chord-diagrams') as HTMLElement;
    const sbChordSheet = document.getElementById('sb-chord-sheet') as HTMLElement;
    const sbTransReadout = document.getElementById('sb-trans-readout') as HTMLElement;

    const NOTES_SHARP = ['C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#', 'A', 'A#', 'B'];
    const NOTE_TO_INDEX: Record<string, number> = {
      C: 0, 'B#': 0,
      'C#': 1, Db: 1,
      D: 2,
      'D#': 3, Eb: 3,
      E: 4, Fb: 4,
      F: 5, 'E#': 5,
      'F#': 6, Gb: 6,
      G: 7,
      'G#': 8, Ab: 8,
      A: 9,
      'A#': 10, Bb: 10,
      B: 11, Cb: 11,
    };

    function transposeChordToken(token: string, semitones: number): string {
      if (semitones === 0) return token;
      return token.replace(/^([A-G][#b]?)(.*)$/, (_, root, suffix) => {
        const idx = NOTE_TO_INDEX[root];
        if (idx === undefined) return token;
        const nextIdx = (idx + semitones + 120) % 12;
        const nextRoot = NOTES_SHARP[nextIdx];
        // Also transpose slash bass if present
        const updatedSuffix = suffix.replace(/\/([A-G][#b]?)$/, (__, bass) => {
          const bIdx = NOTE_TO_INDEX[bass];
          if (bIdx === undefined) return __;
          return '/' + NOTES_SHARP[(bIdx + semitones + 120) % 12];
        });
        return nextRoot + updatedSuffix;
      });
    }

    // Play a warm guitar-like arpeggio when user clicks a chord diagram
    function strumChordPreview(chordName: string) {
      const AudioContextClass = window.AudioContext || (window as any).webkitAudioContext;
      if (!audioCtx) audioCtx = new AudioContextClass();
      if (audioCtx.state === 'suspended') audioCtx.resume();

      const match = chordName.match(/^([A-G][#b]?)(.*)$/);
      if (!match) return;
      const rootIdx = NOTE_TO_INDEX[match[1]] ?? 0;
      const qual = match[2] || '';

      // Build intervals (root, 3rd, 5th, 7th, 9th)
      const isMinor = qual.startsWith('m') && !qual.startsWith('maj');
      const isHalfDim = qual.includes('b5');
      const isMaj7 = qual.includes('7M') || qual.includes('maj7');
      const intervals = [
        0,
        isMinor ? 3 : 4,
        isHalfDim ? 6 : 7,
        isMaj7 ? 11 : 10,
        14,
      ];

      const now = audioCtx.currentTime;
      intervals.forEach((interval, i) => {
        if (!audioCtx) return;
        const midi = 48 + rootIdx + interval;
        const freq = 440 * Math.pow(2, (midi - 69) / 12);
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = 'triangle';
        osc.frequency.value = freq;

        const start = now + i * 0.045;
        gain.gain.setValueAtTime(0.001, start);
        gain.gain.linearRampToValueAtTime(0.11, start + 0.015);
        gain.gain.exponentialRampToValueAtTime(0.0008, start + 1.35);

        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start(start);
        osc.stop(start + 1.4);
      });
    }

    function createChordDiagramSVG(chordName: string, shape: any): string {
      const frets: (number | string)[] = shape?.frets || ['x', 0, 2, 2, 1, 0];
      const numericFrets = frets.filter((f): f is number => typeof f === 'number' && f > 0);
      const minFret = numericFrets.length > 0 ? Math.min(...numericFrets) : 1;
      const maxFret = numericFrets.length > 0 ? Math.max(...numericFrets) : 4;
      const baseFret = maxFret <= 4 ? 1 : minFret;

      const width = 110;
      const height = 128;
      const padLeft = 22;
      const padTop = 26;
      const gridW = 70;
      const gridH = 80;
      const stringSpacing = gridW / 5;
      const fretSpacing = gridH / 4;

      let svg = `<svg viewBox="0 0 ${width} ${height}" width="104" height="122" class="chord-svg">`;
      // Nut or base fret label
      if (baseFret === 1) {
        svg += `<line x1="${padLeft}" y1="${padTop}" x2="${padLeft + gridW}" y2="${padTop}" stroke="#e6b87d" stroke-width="3.5" />`;
      } else {
        svg += `<text x="6" y="${padTop + fretSpacing * 0.7}" fill="#e6b87d" font-size="10" font-family="monospace">${baseFret}ª</text>`;
      }

      // Fret lines
      for (let f = 0; f <= 4; f++) {
        const y = padTop + f * fretSpacing;
        svg += `<line x1="${padLeft}" y1="${y}" x2="${padLeft + gridW}" y2="${y}" stroke="rgba(217,155,82,0.35)" stroke-width="1" />`;
      }

      // String lines
      for (let s = 0; s < 6; s++) {
        const x = padLeft + s * stringSpacing;
        svg += `<line x1="${x}" y1="${padTop}" x2="${x}" y2="${padTop + gridH}" stroke="rgba(243,231,214,0.45)" stroke-width="${s < 3 ? 1.4 : 1}" />`;
      }

      // Dots and open/muted markers
      frets.forEach((f, s) => {
        const x = padLeft + s * stringSpacing;
        if (f === 'x' || f === 'X') {
          svg += `<text x="${x}" y="${padTop - 7}" text-anchor="middle" fill="#a8947e" font-size="10" font-family="monospace">×</text>`;
        } else if (f === 0) {
          svg += `<circle cx="${x}" cy="${padTop - 10}" r="3.5" fill="none" stroke="#e6b87d" stroke-width="1.4" />`;
        } else if (typeof f === 'number' && f > 0) {
          const relFret = f - baseFret + 1;
          const cy = padTop + (relFret - 0.5) * fretSpacing;
          svg += `<circle cx="${x}" cy="${cy}" r="5.5" fill="#d99b52" />`;
        }
      });

      svg += `</svg>`;
      return svg;
    }

    function renderSongbookForTrack(track: any) {
      const sb = track.songbook;
      if (!sb || !sbEyebrow) return;

      sbEyebrow.textContent = `POR TRÁS DA CORTINA · FAIXA ${track.numberStr} (LADO ${track.side})`;
      sbTrackTitle.textContent = track.fullTitle;
      sbKeyBadge.textContent =
        currentTranspose === 0
          ? sb.key
          : `${transposeChordToken(sb.key.split(' ')[0], currentTranspose)} (${currentTranspose > 0 ? '+' : ''}${currentTranspose} st)`;
      sbTimeBadge.textContent = `${sb.timeSignature} · ${track.bpm} BPM`;
      sbCapoBadge.textContent = sb.capoHint;
      sbCurtainText.textContent = sb.behindTheCurtain;
      sbFeelText.textContent = sb.feel;
      sbTransReadout.textContent =
        currentTranspose === 0
          ? '0 st (Original)'
          : `${currentTranspose > 0 ? '+' : ''}${currentTranspose} semitom`;

      // Render Groove Matrix
      if (sb.groovePattern && sbGrooveMatrix) {
        sbGrooveLabel.textContent = sb.groovePattern.label;
        const subs: string[] = sb.groovePattern.subdivisions;
        let html = `<div class="groove-row groove-head"><span class="groove-voice-name">Pulso</span>`;
        subs.forEach((sub) => {
          html += `<span class="groove-cell groove-sub">${sub}</span>`;
        });
        html += `</div>`;

        sb.groovePattern.voices.forEach((v: any) => {
          html += `<div class="groove-row"><span class="groove-voice-name">${v.name}</span>`;
          v.hits.forEach((hit: number) => {
            html += `<span class="groove-cell ${hit ? 'hit' : ''}"><i></i></span>`;
          });
          html += `</div>`;
        });
        sbGrooveMatrix.innerHTML = html;
      }

      // Render Chord Diagrams
      if (sbChordDiagrams) {
        sbChordDiagrams.innerHTML = '';
        const shapesDict = album.chordShapes || {};
        sb.chordsUsed.forEach((origChord: string) => {
          const displayedChord = transposeChordToken(origChord, currentTranspose);
          const shape = shapesDict[displayedChord] || shapesDict[origChord] || null;
          const card = document.createElement('button');
          card.type = 'button';
          card.className = 'chord-diagram-card';
          card.title = `Clique para ouvir o acorde ${displayedChord}`;
          card.innerHTML = `
            <strong class="chord-card-name">${displayedChord}</strong>
            ${createChordDiagramSVG(displayedChord, shape)}
          `;
          card.addEventListener('click', () => strumChordPreview(displayedChord));
          sbChordDiagrams.appendChild(card);
        });
      }

      // Render Chord Sheet with transposition
      if (sbChordSheet && sb.chordSheet) {
        const chordRegex = /^[A-G][#b]?(m|M|maj|dim|aug|sus|[0-9]|\(|b|#|-|\/|\))*$/;
        const lines = sb.chordSheet.split('\n');
        sbChordSheet.innerHTML = '';

        lines.forEach((line: string) => {
          const trimmed = line.trim();
          const row = document.createElement('div');
          if (!trimmed) {
            row.className = 'sheet-spacer';
            sbChordSheet.appendChild(row);
            return;
          }
          if (trimmed.startsWith('[')) {
            row.className = 'sheet-section-tag';
            row.textContent = trimmed;
            sbChordSheet.appendChild(row);
            return;
          }

          const tokens = trimmed.split(/\s+/);
          const isChordLine =
            tokens.length > 0 &&
            tokens.every(
              (tok: string) =>
                chordRegex.test(tok) ||
                tok === '(Breque!)' ||
                tok === '(Para' ||
                tok === 'tudo!)' ||
                tok === '(deixar' ||
                tok === 'soar)' ||
                tok === '->'
            );

          if (isChordLine) {
            row.className = 'sheet-chord-line';
            // Transpose each chord while preserving spacing
            const transposedLine = line.replace(/([A-G][#b]?(?:m|M|maj|dim|aug|sus|[0-9]|\(|b|#|-|\/|\))*)/g, (m) =>
              transposeChordToken(m, currentTranspose)
            );
            row.textContent = transposedLine;
          } else {
            row.className = 'sheet-lyric-line';
            row.textContent = line;
          }
          sbChordSheet.appendChild(row);
        });
      }
    }

    // DOM Elements
    const audio = document.getElementById('jukebox-audio') as HTMLAudioElement;
    const vinylStage = document.getElementById('vinyl-stage') as HTMLElement;
    const sleeveAndRecord = document.getElementById('sleeve-and-record') as HTMLElement;
    const tonearmRod = document.getElementById('tonearm-rod') as HTMLElement;
    const btnSideA = document.getElementById('btn-side-a') as HTMLButtonElement;
    const btnSideB = document.getElementById('btn-side-b') as HTMLButtonElement;
    const btnFlipDisc = document.getElementById('btn-flip-disc') as HTMLButtonElement;
    const btnDeckFlip = document.getElementById('btn-deck-flip') as HTMLButtonElement;
    const sleeveSideRibbon = document.getElementById('sleeve-side-ribbon') as HTMLElement;
    const labelSideIndicator = document.getElementById('label-side-indicator') as HTMLElement;
    const labelTrackReadout = document.getElementById('label-track-readout') as HTMLElement;
    const vinylCenterLabel = document.getElementById('vinyl-center-label') as HTMLElement;
    const narrativeSideTag = document.getElementById('narrative-side-tag') as HTMLElement;
    const narrativeSideDesc = document.getElementById('narrative-side-desc') as HTMLElement;
    const filterSideBtn = document.getElementById('filter-side-btn') as HTMLButtonElement;
    const filterAllBtn = document.getElementById('filter-all-btn') as HTMLButtonElement;
    const trackRows = Array.from(document.querySelectorAll('.track-row')) as HTMLButtonElement[];
    const sideFlipBanner = document.getElementById('side-flip-banner') as HTMLElement;

    // Lyrics & Hero Elements
    const heroSideBadge = document.getElementById('hero-side-badge') as HTMLElement;
    const heroStyleBadge = document.getElementById('hero-style-badge') as HTMLElement;
    const heroBpmBadge = document.getElementById('hero-bpm-badge') as HTMLElement;
    const heroDurBadge = document.getElementById('hero-dur-badge') as HTMLElement;
    const heroTrackTitle = document.getElementById('hero-track-title') as HTMLElement;
    const heroLinerText = document.getElementById('hero-liner-text') as HTMLElement;
    const lyricsStanzasList = document.getElementById('lyrics-stanzas-list') as HTMLElement;
    const lyricsViewport = document.getElementById('lyrics-viewport') as HTMLElement;

    // Deck Elements
    const btnPlay = document.getElementById('btn-play') as HTMLButtonElement;
    const iconPlay = document.getElementById('icon-play') as HTMLElement;
    const iconPause = document.getElementById('icon-pause') as HTMLElement;
    const btnPrev = document.getElementById('btn-prev') as HTMLButtonElement;
    const btnNext = document.getElementById('btn-next') as HTMLButtonElement;
    const seekSlider = document.getElementById('seek-slider') as HTMLInputElement;
    const timeCurrent = document.getElementById('time-current') as HTMLElement;
    const timeTotal = document.getElementById('time-total') as HTMLElement;
    const volumeSlider = document.getElementById('volume-slider') as HTMLInputElement;
    const chkAutoFlip = document.getElementById('chk-auto-flip') as HTMLInputElement;
    const deckSidePill = document.getElementById('deck-side-pill') as HTMLElement;
    const deckBpmPill = document.getElementById('deck-bpm-pill') as HTMLElement;
    const deckTrackTitle = document.getElementById('deck-track-title') as HTMLElement;
    const deckTrackStyle = document.getElementById('deck-track-style') as HTMLElement;

    // Web Audio API Vinyl Crackle Synthesizer
    let audioCtx: AudioContext | null = null;
    let crackleNode: ScriptProcessorNode | null = null;
    let crackleGain: GainNode | null = null;
    let crackleEnabled = false;
    const btnCrackleToggle = document.getElementById('btn-crackle-toggle') as HTMLButtonElement;
    const crackleLed = document.getElementById('crackle-led') as HTMLElement;

    function toggleVinylCrackle() {
      crackleEnabled = !crackleEnabled;
      crackleLed.classList.toggle('on', crackleEnabled);
      btnCrackleToggle.classList.toggle('active', crackleEnabled);

      if (crackleEnabled) {
        if (!audioCtx) {
          const AudioContextClass = window.AudioContext || (window as any).webkitAudioContext;
          audioCtx = new AudioContextClass();
          crackleNode = audioCtx.createScriptProcessor(4096, 1, 1);
          let lastOut = 0.0;
          crackleNode.onaudioprocess = (e) => {
            const output = e.outputBuffer.getChannelData(0);
            for (let i = 0; i < output.length; i++) {
              // Warm surface hiss + occasional micro vinyl dust pop
              const white = Math.random() * 2 - 1;
              lastOut = (lastOut + 0.04 * white) / 1.04;
              let sample = lastOut * 0.14;
              if (Math.random() < 0.0018) {
                sample += (Math.random() * 2 - 1) * 0.65;
              }
              output[i] = sample;
            }
          };
          crackleGain = audioCtx.createGain();
          crackleGain.gain.value = isPlaying ? 0.045 : 0.01;
          crackleNode.connect(crackleGain);
          crackleGain.connect(audioCtx.destination);
        }
        if (audioCtx.state === 'suspended') {
          audioCtx.resume();
        }
        if (crackleGain) {
          crackleGain.gain.value = isPlaying ? 0.045 : 0.012;
        }
      } else if (crackleGain) {
        crackleGain.gain.value = 0;
      }
    }

    btnCrackleToggle?.addEventListener('click', toggleVinylCrackle);

    function formatSec(sec: number): string {
      if (!Number.isFinite(sec) || sec < 0) return '00:00';
      const total = Math.floor(sec);
      const m = Math.floor(total / 60);
      const s = total % 60;
      return `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
    }

    function applyTrackFilter() {
      trackRows.forEach((row) => {
        const rowSide = row.getAttribute('data-track-side');
        if (trackFilter === 'all' || rowSide === activeSide) {
          row.style.display = 'grid';
        } else {
          row.style.display = 'none';
        }
      });
    }

    function updateSideUI(side: 'A' | 'B', animateFlip = false) {
      activeSide = side;
      const sideMeta = album.sides[side];

      btnSideA.classList.toggle('active', side === 'A');
      btnSideB.classList.toggle('active', side === 'B');
      vinylStage.setAttribute('data-active-side', side);

      if (animateFlip) {
        sleeveAndRecord.classList.add('flipping');
        setTimeout(() => sleeveAndRecord.classList.remove('flipping'), 650);
      }

      sleeveSideRibbon.textContent = `LADO ${side} · ${sideMeta.title.toUpperCase()}`;
      labelSideIndicator.textContent = `LADO ${side}`;
      vinylCenterLabel.setAttribute('data-side', side);

      narrativeSideTag.textContent = `LADO ${side} — ${sideMeta.title.toUpperCase()} (${sideMeta.durationFormatted})`;
      narrativeSideDesc.textContent = sideMeta.description;

      applyTrackFilter();
    }

    function renderLyricsForTrack(track: any) {
      lyricsStanzasList.innerHTML = '';
      track.stanzas.forEach((stanza: any, idx: number) => {
        const div = document.createElement('div');
        div.className = `lyric-stanza${idx === 0 ? ' active' : ''}`;
        div.setAttribute('data-stanza-index', String(idx));
        div.setAttribute('data-start', String(stanza.startTime));
        div.setAttribute('data-end', String(stanza.endTime));
        div.title = 'Clique para pular para este trecho da faixa';

        const timeTag = document.createElement('span');
        timeTag.className = 'stanza-time-tag';
        timeTag.textContent = formatSec(stanza.startTime);
        div.appendChild(timeTag);

        stanza.lines.forEach((line: string) => {
          const p = document.createElement('p');
          p.className = 'lyric-line';
          p.textContent = line;
          div.appendChild(p);
        });

        div.addEventListener('click', () => {
          audio.currentTime = stanza.startTime;
          if (!isPlaying) {
            playAudio();
          }
        });

        lyricsStanzasList.appendChild(div);
      });

      lyricsViewport.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function loadTrack(index: number, autoPlay = false) {
      if (flipTimeoutId) {
        clearTimeout(flipTimeoutId);
        flipTimeoutId = null;
        sideFlipBanner.hidden = true;
      }

      currentTrackIdx = (index + album.tracks.length) % album.tracks.length;
      const track = album.tracks[currentTrackIdx];

      if (track.side !== activeSide) {
        updateSideUI(track.side, true);
      }

      // Highlight track row
      trackRows.forEach((row, i) => {
        row.classList.toggle('active', i === currentTrackIdx);
      });

      // Update Center Label & Hero
      labelTrackReadout.textContent = `${track.numberStr}. ${track.title}`;
      heroSideBadge.textContent = `LADO ${track.side} · FAIXA ${track.numberStr}`;
      heroSideBadge.setAttribute('data-side', track.side);
      heroStyleBadge.textContent = track.style;
      heroBpmBadge.textContent = `${track.bpm} BPM`;
      heroDurBadge.textContent = track.durationFormatted;
      heroTrackTitle.textContent = track.fullTitle;
      heroLinerText.textContent = track.linerNote;

      // Update Deck
      deckSidePill.textContent = `LADO ${track.side}`;
      deckSidePill.setAttribute('data-side', track.side);
      deckBpmPill.textContent = `${track.bpm} BPM`;
      deckTrackTitle.textContent = `${track.numberStr}. ${track.title}`;
      deckTrackStyle.textContent = track.style;

      // Update Audio
      audio.src = track.audioUrl;
      seekSlider.max = String(track.durationSeconds);
      seekSlider.value = '0';
      timeCurrent.textContent = '00:00';
      timeTotal.textContent = track.durationFormatted;

      renderLyricsForTrack(track);
      renderSongbookForTrack(track);
      updateTonearmAngle(0);

      if (autoPlay) {
        playAudio();
      }
    }

    function updateTonearmAngle(progressRatio: number) {
      if (!isPlaying) {
        tonearmRod.style.transform = `rotate(0deg)`;
        return;
      }
      // Sweep from 18deg (outer groove) to 34deg (inner groove)
      const angle = 18 + Math.min(Math.max(progressRatio, 0), 1) * 16;
      tonearmRod.style.transform = `rotate(${angle.toFixed(2)}deg)`;
    }

    function playAudio() {
      audio
        .play()
        .then(() => {
          isPlaying = true;
          vinylStage.setAttribute('data-playing', 'true');
          iconPlay.hidden = true;
          iconPause.hidden = false;
          if (crackleEnabled && crackleGain) {
            crackleGain.gain.value = 0.045;
          }
          const ratio = audio.duration ? audio.currentTime / audio.duration : 0;
          updateTonearmAngle(ratio);
        })
        .catch((err) => {
          console.warn('Interação necessária para iniciar reprodução:', err);
        });
    }

    function pauseAudio() {
      audio.pause();
      isPlaying = false;
      vinylStage.setAttribute('data-playing', 'false');
      iconPlay.hidden = false;
      iconPause.hidden = true;
      if (crackleEnabled && crackleGain) {
        crackleGain.gain.value = 0.01;
      }
      updateTonearmAngle(0);
    }

    // Bind initial server-rendered stanzas click
    document.querySelectorAll('.lyric-stanza').forEach((el) => {
      el.addEventListener('click', () => {
        const start = parseFloat(el.getAttribute('data-start') || '0');
        audio.currentTime = start;
        if (!isPlaying) playAudio();
      });
    });

    // Audio Events
    audio.addEventListener('timeupdate', () => {
      const current = audio.currentTime;
      const duration = audio.duration || album.tracks[currentTrackIdx].durationSeconds;
      seekSlider.value = String(current);
      timeCurrent.textContent = formatSec(current);

      const ratio = duration > 0 ? current / duration : 0;
      updateTonearmAngle(ratio);

      // Sync active lyric stanza
      const stanzaEls = Array.from(lyricsStanzasList.querySelectorAll('.lyric-stanza')) as HTMLElement[];
      let activeStanzaEl: HTMLElement | null = null;

      for (const el of stanzaEls) {
        const start = parseFloat(el.getAttribute('data-start') || '0');
        const end = parseFloat(el.getAttribute('data-end') || '9999');
        if (current >= start && current <= end) {
          activeStanzaEl = el;
          break;
        }
      }

      if (activeStanzaEl && !activeStanzaEl.classList.contains('active')) {
        stanzaEls.forEach((el) => el.classList.remove('active'));
        activeStanzaEl.classList.add('active');
        if (autoScrollLyrics) {
          activeStanzaEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      }
    });

    audio.addEventListener('ended', () => {
      const finishedTrack = album.tracks[currentTrackIdx];
      // Check if this is Track 05 (end of Side A with dramatic 3.5s silence)
      if (finishedTrack.pauseAfterSeconds > 0 && currentTrackIdx === 4) {
        pauseAudio();
        if (chkAutoFlip.checked) {
          sideFlipBanner.hidden = false;
          flipTimeoutId = window.setTimeout(() => {
            sideFlipBanner.hidden = true;
            loadTrack(5, true); // Track 06 (Start of Side B)
          }, finishedTrack.pauseAfterSeconds * 1000);
        } else {
          updateSideUI('B', true);
          loadTrack(5, false);
        }
        return;
      }

      if (currentTrackIdx < album.tracks.length - 1) {
        loadTrack(currentTrackIdx + 1, true);
      } else {
        pauseAudio();
      }
    });

    // Transport Controls
    btnPlay.addEventListener('click', () => {
      if (isPlaying) pauseAudio();
      else playAudio();
    });

    btnPrev.addEventListener('click', () => {
      if (audio.currentTime > 4) {
        audio.currentTime = 0;
      } else {
        loadTrack(currentTrackIdx - 1, isPlaying);
      }
    });

    btnNext.addEventListener('click', () => {
      loadTrack(currentTrackIdx + 1, isPlaying);
    });

    document.getElementById('btn-lyric-prev')?.addEventListener('click', () => {
      loadTrack(currentTrackIdx - 1, isPlaying);
    });
    document.getElementById('btn-lyric-next')?.addEventListener('click', () => {
      loadTrack(currentTrackIdx + 1, isPlaying);
    });

    seekSlider.addEventListener('input', () => {
      audio.currentTime = parseFloat(seekSlider.value);
    });

    volumeSlider.addEventListener('input', () => {
      audio.volume = parseFloat(volumeSlider.value);
    });

    // Tracklist clicks
    trackRows.forEach((row) => {
      row.addEventListener('click', () => {
        const idx = parseInt(row.getAttribute('data-track-index') || '0', 10);
        if (idx === currentTrackIdx) {
          if (isPlaying) pauseAudio();
          else playAudio();
        } else {
          loadTrack(idx, true);
        }
      });
    });

    // Side Switching ("Virar Disco")
    function flipSide(targetSide?: 'A' | 'B') {
      const nextSide = targetSide || (activeSide === 'A' ? 'B' : 'A');
      updateSideUI(nextSide, true);
      // If current track is not on the newly flipped side, jump to the first track of that side
      const currentTrack = album.tracks[currentTrackIdx];
      if (currentTrack.side !== nextSide) {
        const firstTrackOfSideIdx = album.tracks.findIndex((t: any) => t.side === nextSide);
        if (firstTrackOfSideIdx !== -1) {
          loadTrack(firstTrackOfSideIdx, isPlaying);
        }
      }
    }

    btnSideA.addEventListener('click', () => flipSide('A'));
    btnSideB.addEventListener('click', () => flipSide('B'));
    btnFlipDisc.addEventListener('click', () => flipSide());
    btnDeckFlip.addEventListener('click', () => flipSide());

    // Filter Side vs All Tracks
    filterSideBtn.addEventListener('click', () => {
      trackFilter = 'side';
      filterSideBtn.classList.add('active');
      filterAllBtn.classList.remove('active');
      applyTrackFilter();
    });

    filterAllBtn.addEventListener('click', () => {
      trackFilter = 'all';
      filterAllBtn.classList.add('active');
      filterSideBtn.classList.remove('active');
      applyTrackFilter();
    });

    // Stage Mode Toggle (Capa + Vinil vs Vitrola Aberta)
    const modeSleeveBtn = document.getElementById('mode-sleeve-btn');
    const modePlatterBtn = document.getElementById('mode-platter-btn');
    const lpSleeve = document.getElementById('lp-sleeve');

    modeSleeveBtn?.addEventListener('click', () => {
      vinylStage.classList.remove('platter-only');
      modeSleeveBtn.classList.add('active');
      modePlatterBtn?.classList.remove('active');
    });

    modePlatterBtn?.addEventListener('click', () => {
      vinylStage.classList.add('platter-only');
      modePlatterBtn.classList.add('active');
      modeSleeveBtn?.classList.remove('active');
    });

    lpSleeve?.addEventListener('click', () => {
      const isPlatter = vinylStage.classList.toggle('platter-only');
      modePlatterBtn?.classList.toggle('active', isPlatter);
      modeSleeveBtn?.classList.toggle('active', !isPlatter);
    });

    // Right Column Tabs (Letra / Songbook / Capa Interna / Estúdio)
    const tabBtns = Array.from(document.querySelectorAll('.booklet-tab'));
    const panels: Record<string, HTMLElement | null> = {
      lyrics: document.getElementById('panel-lyrics'),
      songbook: document.getElementById('panel-songbook'),
      gatefold: document.getElementById('panel-gatefold'),
      studio: document.getElementById('panel-studio'),
    };
    const lyricsToolbar = document.getElementById('lyrics-toolbar');

    // Transposer Buttons
    document.getElementById('btn-trans-down')?.addEventListener('click', () => {
      currentTranspose = ((currentTranspose - 1 + 18) % 12) - 6;
      renderSongbookForTrack(album.tracks[currentTrackIdx]);
    });
    document.getElementById('btn-trans-up')?.addEventListener('click', () => {
      currentTranspose = ((currentTranspose + 1 + 18) % 12) - 6;
      renderSongbookForTrack(album.tracks[currentTrackIdx]);
    });
    document.getElementById('btn-trans-easy')?.addEventListener('click', () => {
      const sb = album.tracks[currentTrackIdx]?.songbook;
      currentTranspose = sb?.easyTransposeSemitones ?? 0;
      renderSongbookForTrack(album.tracks[currentTrackIdx]);
    });
    document.getElementById('btn-trans-reset')?.addEventListener('click', () => {
      currentTranspose = 0;
      renderSongbookForTrack(album.tracks[currentTrackIdx]);
    });

    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-tab-target') || 'lyrics';
        tabBtns.forEach((b) => b.classList.toggle('active', b === btn));
        Object.entries(panels).forEach(([key, panel]) => {
          if (panel) {
            const isTarget = key === target;
            panel.hidden = !isTarget;
            panel.classList.toggle('active', isTarget);
          }
        });
        if (lyricsToolbar) {
          lyricsToolbar.style.visibility = target === 'lyrics' ? 'visible' : 'hidden';
        }
      });
    });

    // Lyrics Toolbar Controls
    const btnAutoScroll = document.getElementById('btn-autoscroll');
    btnAutoScroll?.addEventListener('click', () => {
      autoScrollLyrics = !autoScrollLyrics;
      btnAutoScroll.classList.toggle('active', autoScrollLyrics);
    });

    document.getElementById('btn-font-inc')?.addEventListener('click', () => {
      lyricFontScale = Math.min(lyricFontScale + 0.1, 1.45);
      lyricsStanzasList.style.setProperty('--lyric-scale', String(lyricFontScale));
    });

    document.getElementById('btn-font-dec')?.addEventListener('click', () => {
      lyricFontScale = Math.max(lyricFontScale - 0.1, 0.85);
      lyricsStanzasList.style.setProperty('--lyric-scale', String(lyricFontScale));
    });

    // Crate Drawer Toggle
    const crateDrawer = document.getElementById('crate-drawer');
    const btnOpenCrate = document.getElementById('btn-open-crate');
    const btnCloseCrate = document.getElementById('btn-close-crate');

    btnOpenCrate?.addEventListener('click', () => {
      if (!crateDrawer) return;
      const isHidden = crateDrawer.hidden;
      crateDrawer.hidden = !isHidden;
      btnOpenCrate.setAttribute('aria-expanded', String(isHidden));
    });

    btnCloseCrate?.addEventListener('click', () => {
      if (crateDrawer) crateDrawer.hidden = true;
      btnOpenCrate?.setAttribute('aria-expanded', 'false');
    });

    // Copy YouTube Chapters
    const btnCopyChapters = document.getElementById('btn-copy-chapters');
    const chaptersPre = document.getElementById('chapters-pre');
    btnCopyChapters?.addEventListener('click', () => {
      if (!chaptersPre) return;
      navigator.clipboard.writeText(chaptersPre.textContent || '');
      const original = btnCopyChapters.textContent;
      btnCopyChapters.textContent = 'Copiado!';
      setTimeout(() => {
        btnCopyChapters.textContent = original;
      }, 2000);
    });

    // Keyboard Shortcuts
    window.addEventListener('keydown', (e) => {
      if (['INPUT', 'TEXTAREA'].includes((e.target as HTMLElement)?.tagName)) return;
      if (e.code === 'Space') {
        e.preventDefault();
        if (isPlaying) pauseAudio();
        else playAudio();
      } else if (e.key === 'f' || e.key === 'F') {
        flipSide();
      } else if (e.key === 'n' || e.key === 'N') {
        loadTrack(currentTrackIdx + 1, isPlaying);
      } else if (e.key === 'p' || e.key === 'P') {
        loadTrack(currentTrackIdx - 1, isPlaying);
      }
    });

    // Initialize filter for Side A and render initial Songbook
    applyTrackFilter();
    renderSongbookForTrack(album.tracks[0]);
  }
</script>

